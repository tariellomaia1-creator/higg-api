# Copy the names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Site password (the login screen).
SITE_PASSWORD=

# Higgsfield platform key (key-id:key-secret) used by the daily scheduler.
HF_API_KEY=
HF_API_BASE_URL=https://platform.higgsfield.ai
# Optional overrides if the platform paths differ.
# HF_VIDEO_MODEL_PATH=veo3.1/lite/image-to-video
# HF_POSTER_MODEL_PATH=openai/gpt-image-2.6

# Shared secret between GitHub Actions and /api/cron/tick (any long random string).
CRON_SECRET=

# Set automatically when you connect Neon Postgres and Vercel Blob in Vercel → Storage.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Storage warning threshold in MB (Hobby Blob = 1000).
# BLOB_LIMIT_MB=1000

# Meta: Facebook Page and its linked Instagram Business account.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# META_GRAPH_VERSION=v23.0
