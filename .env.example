# Copy the names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Site password (the login screen).
SITE_PASSWORD=

# kie.ai API key (kie.ai/api-key) used by the daily scheduler:
# Veo 3.1 Lite for videos, GPT Image 2.6 Sunburst for posters.
KIE_API_KEY=

# Higgsfield key for the /studio page only (users paste their own key there).
HF_API_BASE_URL=https://platform.higgsfield.ai

# Shared secret between GitHub Actions and /api/cron/tick (any long random string).
CRON_SECRET=

# Set automatically when you connect Neon Postgres and Vercel Blob in Vercel → Storage.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Without Vercel Blob (e.g. on Hostinger) files are kept on the server's disk.
# SITE_URL is the site's public address, used for the file links Meta and kie.ai
# download. STORAGE_DIR defaults to ~/autopost-storage (outside the app, so
# redeploys keep it).
SITE_URL=
# STORAGE_DIR=
# Storage warning threshold in MB (Hobby Blob = 1000).
# BLOB_LIMIT_MB=1000

# Meta: Facebook Page and its linked Instagram Business account.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Other pages you administer (heads.ge, …): a long-lived user or system-user
# token with pages_show_list, pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish. Pages are picked in Auto posting.
META_USER_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
